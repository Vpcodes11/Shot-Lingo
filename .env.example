# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ---------- Supabase (accounts + database) ----------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI ----------
ANTHROPIC_API_KEY=
# Optional model override. Default claude-opus-5-5; claude-haiku-5-5 is much cheaper.
AI_MODEL=

# ---------- Payments: Lemon Squeezy ----------
# Product "Share" links (Products -> ... -> Share). Users are signed in before checkout.
LEMONSQUEEZY_CHECKOUT_MONTHLY_URL=
LEMONSQUEEZY_CHECKOUT_YEARLY_URL=
LEMONSQUEEZY_CHECKOUT_LIFETIME_URL=
# Settings -> Stores (numeric id)
LEMONSQUEEZY_STORE_ID=
# Settings -> Webhooks -> signing secret you chose
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant id of the lifetime product (Products -> Lifetime -> variant id)
LEMONSQUEEZY_LIFETIME_VARIANT_ID=
# Optional: Settings -> API. Lets "Manage billing" open a fresh portal link.
LEMONSQUEEZY_API_KEY=
# Optional: fallback customer portal, e.g. https://YOURSTORE.lemonsqueezy.com/billing
NEXT_PUBLIC_BILLING_PORTAL_URL=

# ---------- Optional ----------
# Secret for /api/health?key=... which lists missing settings. Generate: openssl rand -hex 16
HEALTH_KEY=
# Comma-separated emails that get Pro for free (you, testers, giveaways)
PRO_EMAILS=
