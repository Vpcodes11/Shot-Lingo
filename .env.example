# Public URL of your deployment (used for SEO/sitemap)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# AI captions + translation (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5). claude-haiku-5-5 is much cheaper.
AI_MODEL=

# Payments: Lemon Squeezy checkout links (enable "license keys" on each product)
NEXT_PUBLIC_CHECKOUT_MONTHLY_URL=
NEXT_PUBLIC_CHECKOUT_YEARLY_URL=
NEXT_PUBLIC_CHECKOUT_LIFETIME_URL=
# Where customers manage purchases (default: Lemon Squeezy "My orders")
NEXT_PUBLIC_BILLING_PORTAL_URL=
# Only accept license keys from your store (recommended)
LEMONSQUEEZY_STORE_ID=

# Optional: comma-separated keys that unlock Pro without a purchase (testers, giveaways)
PRO_LICENSE_KEYS=
